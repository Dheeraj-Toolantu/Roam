# Copy to .env and fill in from Firebase console → Project settings → Your apps → Web app.
# These values are public client identifiers (security comes from firestore.rules / storage.rules).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Local development against the Firebase Emulator Suite (npm run emulators):
# EXPO_PUBLIC_USE_EMULATORS=1
# EXPO_PUBLIC_EMULATOR_HOST=192.168.1.20   # your computer's LAN IP when testing on a physical phone
