rules_version = '2';

// Media storage. Users write only under their own folder; reads require sign-in.
// Object paths are unguessable (uid + random id), and the Firestore document that
// references a file carries the visibility rules for listing it.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isImage() {
      return request.resource.contentType.matches('image/.*') && request.resource.size < 25 * 1024 * 1024;
    }
    // Videos: max 30 seconds (+0.5 s rounding) and 100 MB. The app measures the clip and
    // sends its length as custom metadata `durationMs`; uploads without it are refused.
    function isShortVideo() {
      return request.resource.contentType.matches('video/.*')
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.metadata != null
        && request.resource.metadata.durationMs is string
        && request.resource.metadata.durationMs.matches('^[0-9]{1,6}$')
        && int(request.resource.metadata.durationMs) <= 30500;
    }
    function okMedia() {
      return isImage() || isShortVideo();
    }

    match /media/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && (request.resource == null || okMedia());
    }
    match /avatars/{uid}/{file} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && (request.resource == null || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
    match /receipts/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && (request.resource == null || isImage());
    }
  }
}
